.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  cursor: pointer;
  transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s, opacity 0.2s;
  display: flex;
  flex-direction: column;
  gap: 12px;
  position: relative;
  overflow: hidden;
}

.cited {
  opacity: 0.45;
}

.citedBtn {
  position: absolute;
  top: 10px;
  right: 10px;
  display: flex;
  align-items: center;
  gap: 4px;
  background: var(--elevated);
  border: 1px solid var(--border);
  border-radius: 100px;
  color: var(--text-subtle);
  font-size: 10px;
  font-weight: 600;
  padding: 3px 8px 3px 6px;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
  z-index: 1;
}

.citedBtn:hover {
  color: var(--green);
  border-color: var(--green);
}

.citedBtnActive {
  background: var(--green-dim);
  border-color: var(--green);
  color: var(--green);
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent), var(--teal));
  opacity: 0;
  transition: opacity 0.2s;
}

.card:hover {
  border-color: var(--border-light);
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}

.card:hover::before {
  opacity: 1;
}

.header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pdfIcon {
  color: var(--accent);
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.headerMeta {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: auto;
}

.venue {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
  background: var(--accent-dim);
  border: 1px solid var(--accent);
  padding: 2px 8px;
  border-radius: 100px;
}

.year {
  font-size: 11px;
  font-family: var(--mono);
  color: var(--text-muted);
}

.title {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.authors {
  margin: 0;
  font-size: 11px;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.problem {
  margin: 0;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cite {
  font-style: italic;
  font-size: 10px;
  color: var(--text-subtle);
  font-family: var(--mono);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.chip {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 100px;
  border: 1px solid;
  font-family: var(--mono);
  white-space: nowrap;
}

.chipTask {
  background: var(--teal-dim);
  border-color: var(--teal);
  color: var(--teal);
}

.chipDataset {
  background: var(--green-dim);
  border-color: var(--green);
  color: var(--green);
}

.chipModel {
  background: rgba(251, 191, 36, 0.1);
  border-color: var(--amber);
  color: var(--amber);
}

.chipTag {
  background: var(--accent-dim);
  border-color: var(--accent);
  color: var(--accent);
}

.metrics {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: 6px;
  background: var(--elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 10px;
}

.metric {
  display: flex;
  flex-direction: column;
  gap: 1px;
  text-align: center;
}

.metricVal {
  font-family: var(--mono);
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}

.metricName {
  font-size: 9px;
  color: var(--text-subtle);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.footer {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
  padding-top: 4px;
  border-top: 1px solid var(--border);
}

.date {
  font-size: 10px;
  color: var(--text-subtle);
  font-family: var(--mono);
}

.links {
  display: flex;
  gap: 6px;
}

.link {
  color: var(--text-muted);
  display: flex;
  align-items: center;
  font-size: 12px;
  text-decoration: none;
  transition: color 0.15s;
}

.link:hover {
  color: var(--text);
}


.paperActions {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: auto;
}

.paperAction {
  width: 26px;
  height: 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: transparent;
  color: var(--text-muted);
  transition: border-color 0.15s, color 0.15s, background 0.15s;
}

.paperAction:hover {
  border-color: var(--accent);
  background: var(--accent-dim);
  color: var(--accent);
}

.paperActionDanger:hover {
  border-color: var(--red);
  background: rgba(220, 38, 38, 0.08);
  color: var(--red);
}

.openBtn {
  margin-left: auto;
  font-size: 11px;
  color: var(--accent);
  font-weight: 600;
  opacity: 0;
  transition: opacity 0.2s;
}

.card:hover .openBtn {
  opacity: 1;
}
